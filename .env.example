# Configurações do ANS-Assistant - Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com os valores reais quando necessário.

# --- Configurações Gerais ---
# ENVIRONMENT=development
# LOG_LEVEL=INFO

# --- Configurações do LLM (RAG) ---
# Provedor do modelo de linguagem (opções: gemini, openai)
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-flash-latest
LLM_TEMPERATURE=0.0


# Chaves de API (NUNCA versione arquivos .env com chaves reais!)
GEMINI_API_KEY=sua_chave_gemini_api_aqui
OPENAI_API_KEY=sua_chave_openai_api_aqui

# --- Configurações de Embeddings e Banco Vetorial ---
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VECTORSTORE_DIR=./data/metadata/vectorstore

