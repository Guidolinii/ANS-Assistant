# Configurações do ANS-Assistant - Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com os valores reais quando necessário.

# --- Configurações Gerais ---
# ENVIRONMENT=development
# LOG_LEVEL=INFO

# --- Configurações do LLM ---
# LLM_PROVIDER=openai
# LLM_MODEL_NAME=gpt-4o-mini
# LLM_API_KEY=sua_chave_api_aqui

# --- Configurações do Banco Vetorial ---
# VECTOR_STORE_TYPE=faiss
# VECTOR_STORE_PATH=./data/vectorstore

# --- Configurações de Embeddings ---
# EMBEDDING_MODEL_NAME=text-embedding-3-small
